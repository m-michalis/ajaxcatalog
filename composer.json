{
    "name": "m-michalis/ajaxcatalog",
    "type": "magento-module",
    "license": "GPL-3.0-only",
    "version": "0.5.0",
    "description": "Backend for a custom (webpack) OpenMage frontend: AJAX category/search listings, AJAX add-to-cart, webpack asset injection and critical css.",
    "homepage": "https://github.com/m-michalis/ajaxcatalog",
    "keywords": [
        "openmage",
        "magento1",
        "ajax catalog",
        "webpack"
    ],
    "support": {
        "issues": "https://github.com/m-michalis/ajaxcatalog/issues",
        "source": "https://github.com/m-michalis/ajaxcatalog"
    },
    "require": {
        "php": "^8.2",
        "magento-hackathon/magento-composer-installer": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.6",
        "macopedia/phpstan-magento1": "^1.1",
        "magento-ecg/coding-standard": "^4.5",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.1",
        "squizlabs/php_codesniffer": "^3.7",
        "symplify/easy-coding-standard": "^13.0"
    },
    "suggest": {
        "openmage/magento-lts": ">=20.0"
    },
    "authors": [
        {
            "name": "Michalis Michalis",
            "email": "m@internetcode.gr"
        }
    ],
    "scripts": {
        "php-cs-fixer:test": "vendor/bin/ecs --config=.php-cs-fixer.dist.php",
        "php-cs-fixer:fix": "vendor/bin/ecs --config=.php-cs-fixer.dist.php --fix",
        "phpstan:test": "XDEBUG_MODE=off php vendor/bin/phpstan analyze",
        "phpstan:baseline": "XDEBUG_MODE=off php vendor/bin/phpstan analyze --generate-baseline",
        "phpcs:test": "php -d error_reporting=24575 vendor/bin/phpcs -s -p --standard=.phpcs.dist.xml",
        "rector:test": "vendor/bin/rector process --config=.rector.php --dry-run",
        "rector:fix": "vendor/bin/rector process --config=.rector.php",
        "lint": [
            "@php-cs-fixer:test",
            "@phpstan:test",
            "@phpcs:test"
        ],
        "lint:fix": [
            "@php-cs-fixer:fix",
            "@rector:fix"
        ]
    },
    "config": {
        "allow-plugins": {
            "magento-hackathon/magento-composer-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "magento-root-dir": "root"
    }
}
