#!/bin/bash

## Description: Install OpenMage with module (optionally with Magento 1.9 sample data)
## Usage: setup-openmage [--with-sample-data]
## Example: ddev setup-openmage
## Example: ddev setup-openmage --with-sample-data
## ProjectTypes: magento

set -euo pipefail

WEBROOT="/var/www/html/openmage"
PROJECT_ROOT="/var/www/html"

DB_HOST="db"
DB_USER="db"
DB_PASS="db"
DB_NAME="db"

ADMIN_USER="admin"
ADMIN_PASS="veryl0ngpassw0rd"
ADMIN_EMAIL="admin@example.com"

# ── Sample data (opt-in) ──
# Vinai's compressed Magento 1.9.2.4 sample data. The no-mp3 archive is ~26MB
# NOTE: the archives live on the master branch; there is no 1.9.2.4 branch.
# vs ~65MB for the full one and differs only in product audio files.
SAMPLE_DATA_URL="https://raw.githubusercontent.com/Vinai/compressed-magento-sample-data/master/compressed-no-mp3-magento-sample-data-1.9.2.4.tgz"
SAMPLE_DATA_DIR="${PROJECT_ROOT}/.ddev/.sampleData"
SAMPLE_DATA_ARCHIVE="${SAMPLE_DATA_DIR}/sample-data.tgz"
SAMPLE_DATA_ROOT="${SAMPLE_DATA_DIR}/magento-sample-data-1.9.2.4"

WITH_SAMPLE_DATA=false
for arg in "$@"; do
    case "$arg" in
        --with-sample-data) WITH_SAMPLE_DATA=true ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

# Sample data MUST be imported BEFORE install.php.
# The dump expects a pristine database and creates the catalog tables itself;
# install.php then builds the rest of the schema and the admin user around it.
# Importing afterwards conflicts with the tables install.php has already made.
# (Same ordering OpenMage's own .ddev/commands/web/openmage-install uses.)
install_sample_data() {
    echo "  Fetching Magento 1.9.2.4 sample data..."
    mkdir -p "${SAMPLE_DATA_DIR}"

    if [ ! -f "${SAMPLE_DATA_ARCHIVE}" ]; then
        curl -fL --retry 3 -o "${SAMPLE_DATA_ARCHIVE}" "${SAMPLE_DATA_URL}"
    else
        echo "  Using cached archive."
    fi

    if [ ! -d "${SAMPLE_DATA_ROOT}" ]; then
        tar -xzf "${SAMPLE_DATA_ARCHIVE}" -C "${SAMPLE_DATA_DIR}"
    fi

    echo "  Copying media and skin..."
    mkdir -p "${WEBROOT}/media" "${WEBROOT}/skin"
    cp -a "${SAMPLE_DATA_ROOT}/media/." "${WEBROOT}/media/" 2>/dev/null || true
    cp -a "${SAMPLE_DATA_ROOT}/skin/." "${WEBROOT}/skin/" 2>/dev/null || true

    # Defensive: ROW_FORMAT=FIXED is invalid for InnoDB and aborts the import on
    # modern MariaDB. The 1.9.2.4 no-mp3 dump happens to contain 0 occurrences
    # (verified), but other Vinai archives do, so the rewrite stays.
    echo "  Importing sample data SQL (MariaDB-compatible)..."
    sed -E 's/[[:space:]]+ROW_FORMAT=FIXED//g' \
        "${SAMPLE_DATA_ROOT}/magento_sample_data_for_1.9.2.4.sql" \
        > "${SAMPLE_DATA_DIR}/sample-data.compat.sql"

    mysql -h "${DB_HOST}" -u "${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" \
        < "${SAMPLE_DATA_DIR}/sample-data.compat.sql"

    echo "  Sample data imported."
}

# ── Idempotency guard ──
if [ -f "${WEBROOT}/app/etc/local.xml" ]; then
    if ! grep -q "ddev-generated" "${WEBROOT}/app/etc/local.xml" 2>/dev/null; then
        echo "OpenMage is already installed."
        echo "Frontend: ${DDEV_PRIMARY_URL}"
        echo "Admin:    ${DDEV_PRIMARY_URL}/admin (${ADMIN_USER} / ${ADMIN_PASS})"
        echo ""
        echo "To reinstall: ddev reset-openmage && ddev setup-openmage"
        exit 0
    fi
fi

if [ "$WITH_SAMPLE_DATA" = true ]; then
    echo "=== Setting up OpenMage (with Magento 1.9 sample data) ==="
else
    echo "=== Setting up OpenMage (empty instance, no sample data) ==="
fi

# ── 1. Composer project ──
cd "${WEBROOT}"

if [ ! -f "composer.json" ]; then
    echo "[1/5] Initializing Composer project..."
    composer init \
        --name "internetcode/openmage-dev-instance" \
        --type "project" \
        --license "proprietary" \
        --stability "dev" \
        --no-interaction --quiet

    # Magento composer installer settings
    composer config extra.magento-root-dir "."
    composer config extra.magento-deploystrategy "symlink"
    composer config extra.magento-force true
    composer config extra.magento-core-package-type "magento-source"

    # Allow plugins
    composer config allow-plugins.magento-hackathon/magento-composer-installer true
    composer config allow-plugins.aydin-hassan/magento-core-composer-installer true
    composer config allow-plugins.openmage/composer-plugin true
    # Transitive dependencies of openmage/magento-lts ship Composer plugins.
    # Without these the non-interactive install stalls on a trust prompt.
    composer config allow-plugins.cweagans/composer-patches true
    composer config allow-plugins.php-http/discovery true

    # Path repository for the module (../ is relative to openmage/)
    composer config repositories.module '{"type":"path","url":"../","options":{"symlink":true}}'

    composer require --no-update \
        "aydin-hassan/magento-core-composer-installer:^2.1.0" \
        "openmage/magento-lts:^20.0" \
        "m-michalis/ajaxcatalog:@dev"
else
    echo "[1/5] Composer project already initialized."
fi

# ── 2. Install dependencies ──
echo "[2/5] Installing Composer dependencies..."
composer install --prefer-dist --no-progress
composer require --dev phpunit/phpunit:^10.0 --no-progress 2>/dev/null || true

# ── 3. Remove DDEV-generated local.xml ──
if grep -q "ddev-generated" "${WEBROOT}/app/etc/local.xml" 2>/dev/null; then
    rm -f "${WEBROOT}/app/etc/local.xml"
fi

# ── 3b. Sample data, BEFORE install.php (ordering is load-bearing) ──
if [ "$WITH_SAMPLE_DATA" = true ]; then
    echo "[2b/5] Installing sample data..."
    install_sample_data
fi

# ── 4. Install OpenMage ──
echo "[3/5] Running OpenMage installer..."
php -f "${WEBROOT}/install.php" -- \
    --license_agreement_accepted 'yes' \
    --locale 'en_US' \
    --timezone 'UTC' \
    --default_currency 'EUR' \
    --db_host "${DB_HOST}" \
    --db_name "${DB_NAME}" \
    --db_user "${DB_USER}" \
    --db_pass "${DB_PASS}" \
    --db_prefix '' \
    --url "${DDEV_PRIMARY_URL}/" \
    --use_rewrites 'yes' \
    --use_secure 'yes' \
    --secure_base_url "${DDEV_PRIMARY_URL}/" \
    --use_secure_admin 'yes' \
    --admin_username "${ADMIN_USER}" \
    --admin_lastname 'User' \
    --admin_firstname 'Admin' \
    --admin_email "${ADMIN_EMAIL}" \
    --admin_password "${ADMIN_PASS}" \
    --session_save 'files' \
    --admin_frontname 'admin' \
    --backend_frontname 'admin' \
    --enable_charts 'yes' \
    --skip_url_validation 'yes'

# ── 5. Finalize ──
echo "[4/5] Finalizing..."
mkdir -p "${WEBROOT}/var/export" "${WEBROOT}/media"
chmod -R g+w "${WEBROOT}/var" "${WEBROOT}/media" 2>/dev/null || true
rm -rf "${WEBROOT}/var/cache/"*

echo "[5/5] Reindexing and clearing cache..."
php -f "${WEBROOT}/shell/indexer.php" reindexall 2>/dev/null || true

php -r "
require '${WEBROOT}/app/Mage.php';
Mage::app()->cleanCache();
"

echo ""
echo "=== Setup Complete ==="
echo "Frontend: ${DDEV_PRIMARY_URL}"
echo "Admin:    ${DDEV_PRIMARY_URL}/admin"
echo "Login:    ${ADMIN_USER} / ${ADMIN_PASS}"
